<Window x:Class="pract8.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:pract8"
        mc:Ignorable="d"
        Title="MainWindow" Height="800" Width="1200">
    <DockPanel LastChildFill="True">
        <StackPanel Width="150" DockPanel.Dock="Left" Background="Orange">
            <Menu   Background="Orange" HorizontalAlignment="Left" Foreground="White">
            <MenuItem Click="MainPage_Click">
                <MenuItem.Header>
                    <TextBlock TextAlignment="Center" Padding="10" FontSize="24">Главная</TextBlock>
                </MenuItem.Header>
            </MenuItem>
                <MenuItem Click="Catalog_Click">
                <MenuItem.Header>
                        <TextBlock TextAlignment="Center" Padding="10"  FontSize="24">Каталог</TextBlock>
                </MenuItem.Header>
            </MenuItem >
            <MenuItem Click="BucketList_Click">
                <MenuItem.Header>
                        <TextBlock TextAlignment="Center" Padding="10"  FontSize="24">Корзина</TextBlock>
                </MenuItem.Header>
            </MenuItem>
            <MenuItem Click="Contacts_Click">
                <MenuItem.Header>
                        <TextBlock  TextAlignment="Center" Padding="10"  FontSize="24">Контакты</TextBlock>
                </MenuItem.Header>
            </MenuItem>
        </Menu>
        </StackPanel>

        <Frame NavigationUIVisibility="Hidden" x:Name="MainFrame">
            
        </Frame>
        
    </DockPanel>
</Window>
