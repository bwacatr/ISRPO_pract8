<Page x:Class="pract8.Pages.Contacts"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:pract8.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Contacts">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        
            <Border Grid.Row="0" Background="{StaticResource ButtonBorder}" Margin="50,50,50,50" CornerRadius="15" Width="300" Height="240">
            <Grid >
                <TextBlock VerticalAlignment="Center" MaxWidth="225" Style="{StaticResource Contacts}" Text="«ГигаБайт» — магазин оригинальной электроники 
           с официальной гарантией, быстрой доставкой по Екатеринбургу 
           и помощью в выборе техники под любые задачи." TextWrapping="Wrap"/>
                
            </Grid>
        </Border >

        <Border Grid.Column="1" Background="{StaticResource ButtonBorder}" Margin="50,50,50,50" CornerRadius="15" Width="300" Height="240">
            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock MaxWidth="225" Style="{StaticResource Contacts}" Text="Адрес: г. Екатеринбург, ул. Малышева, д. 51, оф. 204" TextWrapping="Wrap"/>

                    <TextBlock MaxWidth="225" Style="{StaticResource Contacts}" Text="Режим работы: Ежедневно, 10:00 – 21:00
Телефон: +7 (343) 000-00-00
Email: info@gigabyte-ekb.ru" TextWrapping="Wrap"/>
                </StackPanel>

            </Grid>
        </Border >
       

    </Grid>
</Page>
