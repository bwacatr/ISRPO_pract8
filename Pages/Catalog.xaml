<Page x:Class="pract8.Pages.Catalog"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:pract8.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Catalog">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        

        <Border Grid.RowSpan="2" Grid.Row="0" Margin="5,5,5,5" Background="DarkOrange" CornerRadius="20" Height="210" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock HorizontalAlignment="Center" Text="Панель фильтров" Foreground="White" FontSize="18" FontWeight="Bold"/>
                <ComboBox x:Name="GroupComboBox" SelectedIndex="0" Grid.Row="0" Margin="5,5,5,5">
                    <ComboBoxItem Tag="price" Content="По цене" Name="priceFilter"/>
                    <ComboBoxItem Tag="brand" Content="По бренду" Name="brandFilter"/>
                    <ComboBoxItem Tag="name"  Content="По имени" Name="nameFilter"/>
                </ComboBox>

                <Button Content="Принять" Click="Accept_Click" Margin="5,15,5,5" Style="{StaticResource FilterButton}" />
                <Button Content="Сбросить" Click="Reset_Click" Margin="5,15,5,5" Style="{StaticResource FilterButton}"/>
            </StackPanel>

        </Border>
        
        <ScrollViewer Grid.RowSpan="2" Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <ListView   Grid.Column="1" Margin="5,5,5,5" MouseDoubleClick="ProductListView_MouseDoubleClick" PreviewMouseLeftButtonDown="ListView_PreviewMouseLeftButtonDown" x:Name="ProductListView" ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct}"  Grid.RowSpan="2">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>

                                <TextBlock TextWrapping="Wrap" MaxWidth="100" Grid.Row="0" Grid.Column="1" Style="{StaticResource ProductTextBlock}" Text="{Binding Name}"/>
                                <TextBlock TextWrapping="Wrap" MaxWidth="100" Grid.Row="1" Grid.Column="0" Style="{StaticResource ProductTextBlock}" Text="{Binding Price, StringFormat={}{0} ₽}"/>
                                <Image Grid.Row="0" Grid.Column="0" Source="{Binding PicPath}" Width="200" Height="150" Stretch="Uniform"/>

                                <Button Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource ListViewButton}" Click="btnAddToCart_Click" Content="Добавить в корзину" 
        Margin="0,5,0,0"/>
                            </Grid>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </ScrollViewer>
    </Grid>

</Page>
