<Page x:Class="pract8.Pages.ProductDetails"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:pract8.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ProductDetails">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.Column="0" Background="White" CornerRadius="15" Padding="10" Margin="0,0,15,15">
            <Image Source="{Binding PicPath}" Width="300" Height="250" Stretch="Uniform"/>
        </Border>

        <Border Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" Background="DarkOrange" CornerRadius="15" Padding="15">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="Bold" Style="{StaticResource ProductDetailTextBlock}"/>
                <TextBlock Text="{Binding Price, StringFormat={}{0} ₽}" FontSize="18" FontWeight="SemiBold" Style="{StaticResource ProductDetailTextBlock}"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Background="DarkOrange" CornerRadius="15" Padding="15">
            <ScrollViewer>
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Style="{StaticResource ProductDetailTextBlock}" Text="Описание:" FontWeight="Bold"/>
                <TextBlock Text="{Binding Description}" Style="{StaticResource ProductDetailTextBlock}" TextWrapping="Wrap" MaxWidth="600" HorizontalAlignment="Left"/>

                <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                    <TextBlock Text="{Binding Category, StringFormat=Категория: {0}}" Style="{StaticResource ProductDetailTextBlock}" Margin="0,0,20,0"/>
                    <TextBlock Text="{Binding Brand, StringFormat=Бренд: {0}}" Style="{StaticResource ProductDetailTextBlock}"/>
                </StackPanel>

                
                    <StackPanel Orientation="Horizontal" Margin="0,15,0,0" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource ProductDetailTextBlock}" Text="Количество:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox Foreground="White" x:Name="txtAmount" Width="50" Height="50" Text="1" TextAlignment="Center" FontSize="14"/>
                        <Button Foreground="White" Content="Добавить в корзину" Click="Button_Click" Margin="20,0,0,0" Style="{StaticResource ListViewButton}"/>
                    </StackPanel>
                
            </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>
