<Page x:Class="pract8.Pages.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:pract8.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="MainPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="50"/>
        </Grid.ColumnDefinitions>



        <StackPanel Grid.ColumnSpan="3"  Margin="5" HorizontalAlignment="Stretch" >
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBox x:Name="txtInput" Width="540"/>
                <Button  Content="Найти" Click="Button_Click"/>
            </StackPanel>
        </StackPanel>



        <Border Grid.Row="1" Grid.ColumnSpan="3" Background="{StaticResource ButtonBorder}" Margin="50,50,50,50" CornerRadius="15">
            <TextBlock  Style="{StaticResource ShopDescription}" >Добро пожаловать в магазин электроники</TextBlock>
        </Border >
    </Grid>
</Page>
