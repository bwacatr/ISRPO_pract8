<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="Background" Color="White"/>

    <SolidColorBrush x:Key="TextBlockBackground" Color="LightGray"/>
    <SolidColorBrush x:Key="TextBlockForeground" Color="Black"/>

    <SolidColorBrush x:Key="ButtonBackground" Color="White"/>
    <SolidColorBrush x:Key="ButtonHover" Color="Orange"/>
    <SolidColorBrush x:Key="ButtonPressed" Color="Orange"/>
    <SolidColorBrush x:Key="ButtonForeground" Color="Black"/>
    <SolidColorBrush x:Key="ButtonBorder" Color="Orange"/>

</ResourceDictionary>